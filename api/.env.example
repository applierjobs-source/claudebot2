DATABASE_URL="postgresql://user:pass@host:5432/dbname"
JWT_SECRET="your-jwt-secret-min-32-chars"
PORT=3001

# For bot provisioning (DigitalOcean)
DO_TOKEN=
DO_DROPLET_ID=
# Optional: set DO_DROPLET_IP to skip DO API call (avoids timeouts from Railway)
DO_DROPLET_IP=
DO_SSH_USER=root
DO_SSH_PRIVATE_KEY=

# API URL. On Railway, set PUBLIC_API_URL to your public API URL (e.g. https://your-api.railway.app) so bot containers on the Droplet can reach logs/ingest and memory.
API_URL=http://localhost:3001
# PUBLIC_API_URL=   # optional; if set, passed to containers as API_URL (use this on Railway so logs appear)

# Claude API key (injected into bot containers)
ANTHROPIC_API_KEY=

# Agent image (after building with GitHub Actions)
AGENT_IMAGE=ghcr.io/your-org/claudebot-agent:latest
# If image is private: GitHub PAT with read:packages (for docker pull on Droplet)
GHCR_TOKEN=
GHCR_USER=applierjobs-source

# Optional: CORS origin for web app
WEB_ORIGIN=http://localhost:5173
